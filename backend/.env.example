# Copy to backend/.env and fill in. One setting per line, no quotes.
# The file is read once at startup — restart the server after editing it.

# Required: free key from https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional: change if Groq retires the default model
GROQ_MODEL=openai/gpt-oss-120b

# Required in production: signs login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=change-me-to-a-long-random-string

# Optional: comma-separated origins allowed to call the API from a browser.
# Only needed when the frontend is hosted on a different domain than the API.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional: directory for the SQLite files (app.db, shop.db, data/).
# Point this at a mounted disk so uploads and accounts survive a redeploy.
# DATA_DIR=/var/data
